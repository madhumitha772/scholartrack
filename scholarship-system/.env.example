# ---------- Required ----------
PORT=5000
# Local MongoDB:  mongodb://127.0.0.1:27017/scholarship_db
# MongoDB Atlas:  mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/scholarship_db?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/scholarship_db
# Any long random text (24+ characters). Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_this_to_a_long_random_string

# Admin account created automatically on first start
ADMIN_EMAIL=admin@scholartrack.com
ADMIN_PASSWORD=Admin@123

# ---------- Email (welcome mail, password reset link, application updates) ----------
# The public address of your site. Used for the links inside e-mails.
# Local:      http://localhost:5000      Deployed:  https://your-app.onrender.com
APP_URL=http://localhost:5000
# Sender shown to students. The address must be one you own (verified in Brevo, or your Gmail address).
MAIL_FROM="ScholarTrack <your.email@gmail.com>"

# OPTION A (recommended for hosting): Brevo HTTPS API. Works on Render/Railway where SMTP is blocked.
# BREVO_API_KEY=xkeysib-...

# OPTION B (easy on your own computer): Gmail SMTP with an App Password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your.email@gmail.com
# SMTP_PASS=your16characterapppassword   (Google App Password; spaces are ignored)

# Developer shortcut: with NO e-mail configured, print sign-up verification codes in the server console.
# Never use in production (it is ignored when NODE_ENV=production).
# DEV_SHOW_CODE=true

# ---------- Production only ----------
# NODE_ENV=production
# TRUST_PROXY=1

# --- Optional email tuning ---
# Which provider to try first when both Brevo and SMTP are set: brevo | smtp
# (default: SMTP first on your own PC, Brevo first on Render/Railway/Fly)
# MAIL_PROVIDER=smtp
# Set to off to skip the "does this email domain exist" DNS check
# EMAIL_DOMAIN_CHECK=off
